{
  "expo": {
    "jsEngine": "hermes",
    "newArchEnabled": false,
    "name": "Cova",
    "slug": "cova",
    "scheme": "cova",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B3A2D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.cova.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Cova needs camera access to scan your room for 3D modeling.",
        "NSPhotoLibraryUsageDescription": "Cova needs photo library access to import your room photo.",
        "NSUserTrackingUsageDescription": "Cova uses this to improve your design recommendations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B3A2D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "ai.cova.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-camera",
      "expo-image-picker",
      "expo-tracking-transparency"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
