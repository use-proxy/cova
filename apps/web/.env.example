# Supabase
NEXT_PUBLIC_SUPABASE_URL=           # Supabase project URL (xdeacbmkdwqrwxonqaqh.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Supabase anon/public key
SUPABASE_SERVICE_ROLE_KEY=          # Supabase service role key (server only — never expose)
SUPABASE_JWT_SECRET=                # Supabase JWT secret (for QR token validation)

# Analytics + monitoring
NEXT_PUBLIC_POSTHOG_KEY=            # PostHog project API key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=                         # Sentry DSN for error tracking

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI APIs
ANTHROPIC_API_KEY=                  # Anthropic Claude API key
REPLICATE_API_TOKEN=                # Replicate API token (legacy — being deprecated in favour of fal.ai)
FAL_KEY=                            # fal.ai API key — get at fal.ai/dashboard
GEMINI_API_KEY=                     # Google Gemini API key (used by room-analyzer.ts)
UNSPLASH_ACCESS_KEY=                # Unsplash API access key — get at unsplash.com/developers

# Modal (pipeline)
MODAL_TOKEN_ID=                     # Modal token ID
MODAL_TOKEN_SECRET=                 # Modal token secret
PREPROCESS_PIPELINE_WEBHOOK_URL=    # Modal webhook URL for cova-preprocessing-pipeline/preprocess_room_photo
REDESIGN_PIPELINE_WEBHOOK_URL=      # Modal webhook URL for cova-redesign-pipeline

# Marble API (3D lift)
MARBLE_API_KEY=                     # Marble/WorldLabs API key (pending approval)

# Product search
SERPER_API_KEY=                     # Serper.dev Google Shopping API
SEARCHAPI_KEY=                      # SearchApi.io API key

# Affiliate tags
AMAZON_AFFILIATE_TAG=cova03-20      # Amazon Associates tag (active)
TARGET_AFFILIATE_ID=                # Target affiliate ID (Impact network)
ARTICLE_AFFILIATE_ID=               # Article affiliate ID
CRATE_BARREL_AFFILIATE_ID=          # Crate & Barrel (Sovrn)
CB2_AFFILIATE_ID=                   # CB2 (Sovrn — same account as C&B)
WEST_ELM_AFFILIATE_ID=              # West Elm (ShareASale)
RUGGABLE_AFFILIATE_ID=              # Ruggable (CJ)
ONE_KINGS_LANE_AFFILIATE_ID=        # One Kings Lane (CJ)
POTTERY_BARN_AFFILIATE_ID=          # Pottery Barn (ShareASale)
OVERSTOCK_AFFILIATE_ID=             # Overstock/Beyond (CJ)
ETSY_AFFILIATE_ID=                  # Etsy (Awin)

# Stripe (post-MVP)
STRIPE_SECRET_KEY=                  # Stripe secret key
STRIPE_WEBHOOK_SECRET=              # Stripe webhook signing secret

# Human checkpoint flags
# FINGERPRINT_SAVE_VERIFIED is a DEV CHECKLIST FLAG ONLY — it has no runtime effect.
# No production code reads this variable. It exists to track that someone manually
# ran scripts/test-fingerprint-save.ts against a real auth session and confirmed
# style_fingerprints insert works end-to-end.
FINGERPRINT_SAVE_VERIFIED=true
