#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Check 1: No API keys or secrets in staged files (exclude hook/CI config files that contain patterns as search strings)
echo "Checking for secrets..."
if git diff --cached --diff-filter=ACM -- . ':!.husky/' ':!.github/' | grep -E "(sk-ant-api|r8_[a-zA-Z0-9]{20}|eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9)" > /dev/null 2>&1; then
  echo "❌ Potential API key detected in staged files. Remove it before committing."
  exit 1
fi

# Check 2: iOS config plist check
if [ -f "apps/mobile/app.json" ]; then
  if ! grep -q "NSCameraUsageDescription" apps/mobile/app.json; then
    echo "⚠️  Warning: NSCameraUsageDescription missing from app.json"
  fi
fi

echo "✅ Pre-commit checks passed"
exit 0
