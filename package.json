{
  "name": "cova",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate:furniture": "cd scripts && npm run generate:furniture",
    "update:furniture-prices": "cd scripts && npm run update:furniture-prices",
    "generate:furniture:full": "npm run generate:furniture && npm run update:furniture-prices",
    "deploy": "bash scripts/deploy-all.sh",
    "verify": "npx ts-node supabase/functions/tests/run-all.ts",
    "typecheck:mobile": "cd apps/mobile && npx tsc --noEmit",
    "precheck": "npm run typecheck:mobile && npm run verify",
    "test:render": "npx tsx scripts/test-render-e2e.ts",
    "test:ui": "maestro test apps/mobile/.maestro/08_full_flow.yaml",
    "test:ui:render": "maestro test apps/mobile/.maestro/04_render_view.yaml",
    "test:ui:auth": "maestro test apps/mobile/.maestro/01_auth.yaml",
    "test:ui:3d": "maestro test apps/mobile/.maestro/07_3d_viewer.yaml",
    "prepare": "husky"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@types/node": "^25.5.0",
    "husky": "^9.1.7",
    "node-fetch": "^2.7.0",
    "ts-node": "^10.9.2",
    "turbo": "latest",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "three": "0.155.0"
    }
  }
}
