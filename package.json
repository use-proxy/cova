{
  "name": "cova",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate:furniture": "cd scripts && npm run generate:furniture",
    "update:furniture-prices": "cd scripts && npm run update:furniture-prices",
    "generate:furniture:full": "npm run generate:furniture && npm run update:furniture-prices",
    "deploy": "bash scripts/deploy-all.sh",
    "verify": "npx ts-node supabase/functions/tests/run-all.ts",
    "typecheck:mobile": "cd apps/mobile && npx tsc --noEmit",
    "precheck": "npm run typecheck:mobile && npm run verify",
    "test:render": "npx tsx scripts/test-render-e2e.ts",
    "test:ui": "cd apps/mobile && bash .maestro/run_all.sh",
    "test:ui:auth": "$HOME/.maestro/bin/maestro test apps/mobile/.maestro/flows/01_splash_and_auth.yaml",
    "test:ui:quiz": "$HOME/.maestro/bin/maestro test apps/mobile/.maestro/flows/02_style_quiz_precise.yaml",
    "test:ui:render": "$HOME/.maestro/bin/maestro test apps/mobile/.maestro/flows/04_render_pipeline_precise.yaml",
    "test:ui:3d": "$HOME/.maestro/bin/maestro test apps/mobile/.maestro/flows/10_3d_viewer_precise.yaml",
    "test:ui:2d": "$HOME/.maestro/bin/maestro test apps/mobile/.maestro/flows/11_2d_floorplan_precise.yaml",
    "test:ui:products": "$HOME/.maestro/bin/maestro test apps/mobile/.maestro/flows/08_product_panel_precise.yaml",
    "test:ui:chat": "$HOME/.maestro/bin/maestro test apps/mobile/.maestro/flows/09_chat_precise.yaml",
    "test:ui:e2e": "$HOME/.maestro/bin/maestro test apps/mobile/.maestro/flows/17_full_new_user_e2e.yaml",
    "prepare": "husky"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.3.0",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@types/node": "^25.5.0",
    "husky": "^9.1.7",
    "node-fetch": "^2.7.0",
    "ts-node": "^10.9.2",
    "turbo": "latest",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "three": "0.155.0"
    }
  }
}
